-    if (running || timer) return;
-    timer = setTimeout(async () => {
-      timer = undefined;
-      dirty = false;
-      running = true;
-      try { await refresh(); }
-      finally {
-        running = false;
-        if (dirty) schedule();
-      }
-    }, delay);
-  };
-  return {
-    schedule,
-    dispose: () => { disposed = true; clearTimeout(timer); },
-  };
-}
