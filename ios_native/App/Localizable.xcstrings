    "admin.users.tempPasswordWarning": {
      "comment": "flutter_app/assets/locales",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這組密碼只顯示一次，關閉後無法再取得（只能再重設一次）。請當面交給本人，並請他登入後立即自行變更密碼。該帳號原有的登入狀態已全部失效。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This password is shown only once and cannot be retrieved after you close this dialog (you would have to reset again). Hand it to the person directly and ask them to change it right after signing in. All of that account’s existing sessions have been signed out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパスワードは一度だけ表示され、閉じると再取得できません（再度リセットが必要です）。本人に直接お渡しし、ログイン後すぐに変更するようお伝えください。このアカウントの既存のログイン状態はすべて無効になりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 비밀번호는 한 번만 표시되며 창을 닫으면 다시 확인할 수 없습니다(다시 재설정해야 합니다). 본인에게 직접 전달하고 로그인 후 바로 변경하도록 안내해 주세요. 이 계정의 기존 로그인은 모두 해제되었습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật khẩu này chỉ hiển thị một lần và không thể lấy lại sau khi đóng (sẽ phải đặt lại lần nữa). Hãy giao trực tiếp cho người đó và nhắc họ tự đổi mật khẩu ngay sau khi đăng nhập. Toàn bộ phiên đăng nhập cũ của tài khoản đã bị hủy."
          }
        }
      }
    },
