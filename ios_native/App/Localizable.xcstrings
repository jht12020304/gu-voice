    "soap.redFlag.defaultReason": {
      "comment": "flutter_app/assets/locales",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此場次曾觸發紅旗警示，建議審閱時特別核對摘要與逐字稿。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This session previously triggered a red-flag alert. Please cross-check the summary and transcript carefully during review."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションは以前レッドフラグ警告を発生させました。審査時は要約と逐語記録を特に念入りに確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션은 이전에 레드플래그 경고가 발생했습니다. 검토 시 요약과 전사본을 특히 꼼꼼히 대조해 주세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên này từng kích hoạt cảnh báo cờ đỏ. Vui lòng đối chiếu kỹ tóm tắt và biên bản hội thoại khi xem xét."
          }
        }
      }
    },
