    "research.forest.subtitle": {
      "comment": "flutter_app/assets/locales",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各語言終態場次的紅旗率點估計與 Wilson 95% CI；虛線為整體率"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Point estimate and Wilson 95% CI of red-flag rate per language (terminal sessions); dashed line is the overall rate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語ごとの終了セッションでのレッドフラグ率の点推定と Wilson 95% CI。破線は全体率"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어별 종료 세션 레드플래그율 점추정과 Wilson 95% CI. 점선은 전체율"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ước lượng điểm và KTC 95% Wilson của tỷ lệ cờ đỏ mỗi ngôn ngữ (buổi kết thúc); đường nét đứt là tỷ lệ chung"
          }
        }
      }
    },
