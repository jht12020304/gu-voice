    "dashboard.reportList.subtitle": {
      "comment": "flutter_app/assets/locales",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "集中查看 AI 問診摘要、待審閱報告與退回修改紀錄。先從待審閱開始，再回到逐字稿核對內容依據。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Review AI consultation summaries, reports awaiting review, and revision requests in one place. Start with the pending queue, then return to the transcript to verify the supporting evidence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 問診の要約、レビュー待ちのレポート、差し戻し記録をまとめて確認できます。まずレビュー待ちから始め、逐語記録に戻って内容の根拠を照合してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 문진 요약, 검토 대기 보고서, 반려 기록을 한곳에서 확인하세요. 검토 대기부터 시작한 뒤 전사본으로 돌아가 근거를 확인하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem tập trung các bản tóm tắt hỏi bệnh AI, báo cáo chờ duyệt và hồ sơ trả về chỉnh sửa. Hãy bắt đầu từ mục chờ duyệt, sau đó quay lại biên bản để đối chiếu căn cứ nội dung."
          }
        }
      }
    },
