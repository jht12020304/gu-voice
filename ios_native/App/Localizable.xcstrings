    "soap.regenerate.description": {
      "comment": "flutter_app/assets/locales",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新產生會以最新逐字稿重新執行 AI 分析，並覆蓋現有 SOAP 報告內容，此動作無法復原。確定要繼續嗎？"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Regenerating will re-run the AI analysis on the latest transcript and overwrite the existing SOAP report. This action cannot be undone. Are you sure you want to continue?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再生成すると、最新の文字起こしでAI分析を再実行し、既存のSOAPレポートを上書きします。この操作は取り消せません。続行しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 생성하면 최신 대화록으로 AI 분석을 다시 실행하고 기존 SOAP 보고서를 덮어씁니다. 이 작업은 되돌릴 수 없습니다. 계속하시겠습니까?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo lại sẽ chạy lại phân tích AI trên bản ghi mới nhất và ghi đè báo cáo SOAP hiện có. Hành động này không thể hoàn tác. Bạn có chắc muốn tiếp tục?"
          }
        }
      }
    },
