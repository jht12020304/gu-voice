    "session.doctor.detail.deleteSessionConfirm": {
      "comment": "flutter_app/assets/locales",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這場問診的對話紀錄、SOAP 報告與紅旗警示，將不再出現在任何清單、報表或統計中。資料仍保留在資料庫，需由系統管理者才能救回。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Its transcript, SOAP report and red-flag alerts will no longer appear in any list, report or statistic. The data stays in the database and only a system administrator can restore it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この問診の会話記録・SOAPレポート・レッドフラグ警告は、一覧・レポート・統計のいずれにも表示されなくなります。データはデータベースに残り、復元できるのはシステム管理者のみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문진의 대화 기록, SOAP 보고서, 레드플래그 경고가 모든 목록·보고서·통계에서 더 이상 표시되지 않습니다. 데이터는 데이터베이스에 남아 있으며 시스템 관리자만 복구할 수 있습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi hội thoại, báo cáo SOAP và cảnh báo cờ đỏ của buổi này sẽ không còn xuất hiện trong bất kỳ danh sách, báo cáo hay thống kê nào. Dữ liệu vẫn nằm trong cơ sở dữ liệu và chỉ quản trị viên hệ thống mới khôi phục được."
          }
        }
      }
    },
