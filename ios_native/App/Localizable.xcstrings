    "research.forest.footnote": {
      "comment": "flutter_app/assets/locales",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點大小反映子群樣本量；CI 越寬代表該語言 n 越小，解讀須謹慎。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Marker size reflects subgroup size; wider CIs indicate smaller n and warrant cautious interpretation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マーカーの大きさはサブグループの n を反映。CI が広いほど n が小さく、解釈は慎重に。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표식 크기는 하위군 n을 반영. CI가 넓을수록 n이 작아 해석에 주의."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kích thước điểm phản ánh cỡ phân nhóm; KTC càng rộng nghĩa là n càng nhỏ, cần diễn giải thận trọng."
          }
        }
      }
    },
