    "admin.users.resetPasswordConfirm": {
      "comment": "flutter_app/assets/locales",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要重設 {{email}} 的密碼嗎？系統會產生一組臨時密碼，並讓該帳號目前所有登入狀態失效。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset the password for {{email}}? A temporary password will be generated and all current sessions for that account will be signed out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{{email}} のパスワードを再設定しますか？一時パスワードを発行し、このアカウントの現在のログイン状態はすべて無効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{{email}} 의 비밀번호를 재설정할까요? 임시 비밀번호가 발급되고 이 계정의 현재 모든 로그인이 해제됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt lại mật khẩu cho {{email}}? Hệ thống sẽ tạo một mật khẩu tạm thời và đăng xuất toàn bộ phiên đang hoạt động của tài khoản này."
          }
        }
      }
    },
