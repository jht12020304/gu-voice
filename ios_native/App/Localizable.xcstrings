    "research.efficiency.footnote": {
      "comment": "flutter_app/assets/locales",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以箱形圖呈現分佈而非長條圖，避免遮蔽資料結構（Weissgerber 2015, PLOS Biology）。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Distributions are shown as box plots rather than bar graphs, which conceal data structure (Weissgerber 2015, PLOS Biology)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データ構造を隠す棒グラフではなく箱ひげ図で分布を示す（Weissgerber 2015, PLOS Biology）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 구조를 가리는 막대그래프 대신 상자그림으로 분포를 표시(Weissgerber 2015, PLOS Biology)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phân bố được thể hiện bằng biểu đồ hộp thay vì biểu đồ cột vốn che giấu cấu trúc dữ liệu (Weissgerber 2015, PLOS Biology)."
          }
        }
      }
    },
    "research.efficiency.subtitle": {
      "comment": "flutter_app/assets/locales",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終態場次的時長 / 輪次 / 每輪字數（箱形圖：中位數、IQR、Tukey whisker、離群點）"
          }
        },
        "en-US": {
