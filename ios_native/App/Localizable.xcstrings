    "soap.review.approveDescription": {
      "comment": "flutter_app/assets/locales",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認此 SOAP 報告可作為正式臨床摘要？如有補充可留下備註。"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm this SOAP report as the official clinical summary? You may add notes if needed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このSOAPレポートを正式な臨床サマリーとして確定しますか？補足があればメモを残せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 SOAP 보고서를 공식 임상 요약으로 확정하시겠습니까? 필요 시 메모를 남길 수 있습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận báo cáo SOAP này là tóm tắt lâm sàng chính thức? Bạn có thể ghi chú thêm nếu cần."
          }
        }
      }
    },
