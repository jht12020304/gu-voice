    "research.methods.triage": {
      "comment": "flutter_app/assets/locales",
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以敏感度／特異度與 under-triage 率評估分流安全（JMIR 等）——本頁紅旗率、偵測延遲、確認率為對應過程指標；正式投稿需以醫師判讀為金標準計算敏感度"
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Triage safety is reported as sensitivity/specificity and under-triage rate (JMIR and others) — red-flag rate, detection latency and acknowledgement rate here are the corresponding process metrics; a formal paper needs physician adjudication as the gold standard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリアージ安全性は感度／特異度と under-triage 率で報告（JMIR など）— 本ページのレッドフラグ率・検出遅延・確認率は対応するプロセス指標。正式な論文には医師判定をゴールドスタンダードとした感度計算が必要"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트리아지 안전성은 민감도/특이도와 under-triage율로 보고(JMIR 등) — 본 페이지의 레드플래그율·감지 지연·확인율은 대응 과정 지표이며, 정식 논문에는 의사 판정을 금표준으로 한 민감도 산출이 필요"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "An toàn triage được báo cáo bằng độ nhạy/độ đặc hiệu và tỷ lệ under-triage (JMIR v.v.) — tỷ lệ cờ đỏ, độ trễ phát hiện và tỷ lệ xác nhận ở đây là chỉ số quá trình tương ứng; bài báo chính thức cần lấy phán định của bác sĩ làm chuẩn vàng để tính độ nhạy"
          }
        }
      }
    },
