# =============================================================================
# UroSense（Gu Voice）backend — 環境變數範本
# 複製為 .env 並填入實際值；請勿將 .env 提交至版本控制。
# 欄位清單與預設值以 app/core/config.py 的 Settings 為準（本檔由其產生）。
# 留空的 key = 未設（走 config.py 預設）；標 # 的 key 是可選替代方案。
# =============================================================================


# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
# development | staging | production（development 會開 /docs 與不設 token 的 /metrics）
APP_ENV=production
# 綁定埠／worker 數是 scripts/start.sh 的 shell 變數（PORT、WORKERS），不是 Settings 欄位
# DEBUG / INFO / WARNING / ERROR / CRITICAL（大小寫皆可，啟動腳本會轉小寫）
# 同時被 Settings.LOG_LEVEL 與 scripts/start.sh 的 uvicorn 讀取
LOG_LEVEL=info
APP_SECRET_KEY=


# -----------------------------------------------------------------------------
# 運維端點的曝光控制（2026-08-22）
# -----------------------------------------------------------------------------
METRICS_ENABLED=true
# /metrics 與正式環境 /openapi.json 的 Bearer token；正式環境沒設＝關閉（fail closed）
METRICS_TOKEN=
# 留空＝依 APP_ENV 決定（development 開、其餘關）；要在正式環境臨時打開才設 true
# DOCS_ENABLED=


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# 方案 A（推薦，Railway / Supabase 插件自動注入即走這條）：
#   顯式設 DATABASE_URL；config.py 的 ASYNC_DATABASE_URL 會自動補上 +asyncpg 驅動，
#   Alembic 用的同步版本也會自動去掉驅動後綴，不需另外設。
# Gotcha：常駐的 Railway 容器務必走 Supabase session-mode pooler（port 5432），
#   不要用 transaction-mode（port 6543）。6543 的 PgBouncer 會讓 asyncpg 的 JSONB
#   codec 型別 introspection 之 prepared statement 跨 backend 失效，造成特定端點 500
#   （錯誤訊息：`prepared statement "__asyncpg_stmt_*__" does not exist`）。
#   正式環境 host 範例：aws-1-ap-southeast-1.pooler.supabase.com（session pooler 用戶名為 postgres.[YOUR-PROJECT-REF]）
DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres
# 方案 B（本機 / docker-compose）：不設 DATABASE_URL，改用下列 DB_* 元件組合
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=gu_voice
# DB_USER=gu_app
# DB_PASSWORD=
# 連線池：Supabase session pooler 連線數有限，正式環境建議調小（5 / 5）；直連或本機可放大
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5


# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
# 方案 A（Railway Redis / Upstash 注入即用）：顯式設 REDIS_URL
REDIS_URL=redis://default:your-password@your-redis-host:6379
# 方案 B（本機）：不設 REDIS_URL，用以下 REDIS_* 元件
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# 鍵值前綴（避免多環境衝突）
REDIS_KEY_PREFIX=gu_prod:
# P3 #29：cache / celery broker / celery result 各走獨立 DB index，
# 防止 FLUSHDB on cache 把 Celery 佇列一起清掉
REDIS_DB_CACHE=0
REDIS_DB_CELERY_BROKER=1
REDIS_DB_CELERY_RESULT=2


# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# RS256（正式）或 HS256（測試／CI；只看 JWT_SECRET_KEY）
JWT_ALGORITHM=RS256
# JWT_SECRET_KEY=
# RS256 金鑰：config.py 會自動判別——
#   值包含 "BEGIN" → 當 PEM 內容（Railway 常這樣貼，\n 字面會自動還原成真換行）
#   否則當檔案路徑 → 從該路徑讀取 PEM
#   都沒設 → fallback 到 JWT_PRIVATE_KEY_PATH / JWT_PUBLIC_KEY_PATH
# 產生方式：openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# 本機開發替代：直接指向檔案路徑
# JWT_PRIVATE_KEY_PATH=keys/private.pem
# JWT_PUBLIC_KEY_PATH=keys/public.pem
# Access Token 有效期（分鐘）；舊名 JWT_ACCESS_TOKEN_EXPIRE_MINUTES 也接受
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh Token 有效期（天）；舊名 JWT_REFRESH_TOKEN_EXPIRE_DAYS 也接受
REFRESH_TOKEN_EXPIRE_DAYS=7


# -----------------------------------------------------------------------------
# OPENAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# 各功能模型與 reasoning_effort 的分工理由見 app/core/config.py 的 OPENAI 區段
OPENAI_MODEL_CONVERSATION=gpt-5.6-luna
OPENAI_MODEL_SUPERVISOR=gpt-5.6-luna
OPENAI_MODEL_SOAP=gpt-5.6-terra
OPENAI_MODEL_RED_FLAG=gpt-5.6-luna
OPENAI_TEMPERATURE_CONVERSATION=0.7
OPENAI_TEMPERATURE_SOAP=0.3
OPENAI_TEMPERATURE_RED_FLAG=0.2
OPENAI_TEMPERATURE_SUPERVISOR=0.2
OPENAI_MAX_TOKENS_CONVERSATION=2048
OPENAI_MAX_TOKENS_SOAP=4096
OPENAI_MAX_TOKENS_SUPERVISOR=4096
# none → 不送 reasoning_effort 改送 temperature；low/medium/high → CoT（API 拒收 temperature，程式端自動不送）
OPENAI_REASONING_EFFORT_CONVERSATION=none
OPENAI_REASONING_EFFORT_SUPERVISOR=medium
OPENAI_REASONING_EFFORT_SOAP=none
OPENAI_REASONING_EFFORT_RED_FLAG=none


# -----------------------------------------------------------------------------
# STT (OpenAI gpt-transcribe，2026-08-22 換代)
# -----------------------------------------------------------------------------
# 回退：設 whisper-1 即回舊路徑
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_STT_LANGUAGE=zh
OPENAI_STT_TIMEOUT_SECONDS=120.0


# -----------------------------------------------------------------------------
# Multi-language (i18n)
# -----------------------------------------------------------------------------
# locale 清單的單一來源是 app/models/enums.py 的 SupportedLanguage（不在此設）
DEFAULT_LANGUAGE=zh-TW
SOAP_REPORT_LANGUAGE=zh-TW
MULTILANG_GLOBAL_ENABLED=true
MULTILANG_ROLLOUT_PERCENT=100
# 緊急 kill-switch，逗號分隔（例：ja-JP,ko-KR）
# MULTILANG_DISABLED_LANGUAGES=
RED_FLAG_BUILTIN_RULES_FALLBACK=true
RED_FLAG_NEGATION_GUARD=true


# -----------------------------------------------------------------------------
# Rate limit（per-IP / per-user policy 旋鈕）
# -----------------------------------------------------------------------------
LOGIN_IP_LIMIT=10
LOGIN_IP_WINDOW=60
PASSWORD_RESET_IP_LIMIT=5
PASSWORD_RESET_IP_WINDOW=900


# -----------------------------------------------------------------------------
# WebSocket / Session Stability (P2)
# -----------------------------------------------------------------------------
OPENAI_MODEL_SUMMARIZER=gpt-5.6-luna
CONVERSATION_HISTORY_MAX_TURNS=50
SUPERVISOR_TIMEOUT_SECONDS=30
SESSION_IDLE_TIMEOUT_SECONDS=600
SESSION_IDLE_CHECK_INTERVAL_SECONDS=30
AUDIO_MAX_DURATION_SECONDS=600
AUDIO_SAMPLE_RATE_HZ=16000


# -----------------------------------------------------------------------------
# 問診自動結束（避免無止盡發問，病患等不到結果）
# -----------------------------------------------------------------------------
HPI_COMPLETION_TERMINATION_ENABLED=true
HPI_COMPLETION_TERMINATION_THRESHOLD=80
MIN_PATIENT_TURNS_BEFORE_AUTO_END=5
MAX_PATIENT_TURNS_HARD_CAP=10
RISK_FACTOR_HARD_CAP_BUFFER=2


# -----------------------------------------------------------------------------
# E2E 稽核修復 kill-switch（docs/archive/e2e_realopenai_audit_2026-06-28.md §三；無 migration）
# -----------------------------------------------------------------------------
LLM_EMPTY_RESPONSE_RETRY=true
HARD_CAP_DRAIN_AWAIT_SECONDS=5.0
MAX_HARD_CAP_DRAIN_DEFERS=2


# -----------------------------------------------------------------------------
# TTS (OpenAI TTS)
# -----------------------------------------------------------------------------
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
OPENAI_TTS_VOICE=nova
OPENAI_TTS_SPEED=0.9


# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# FIREBASE (FCM)
# -----------------------------------------------------------------------------
# base64 編碼的 Firebase Service Account JSON（Railway 無法掛檔）
# 產生方式：base64 -i service-account.json | tr -d '\n'；未設時啟動只 log warning
FCM_CREDENTIALS_JSON=
# iOS 直接 APNs 備援；未設時維持走 FCM
APNS_AUTH_KEY_BASE64=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.guvoice.guVoice


# -----------------------------------------------------------------------------
# SENTRY
# -----------------------------------------------------------------------------
SENTRY_DSN=


# -----------------------------------------------------------------------------
# Email（P3 #31 forgot_password）
# -----------------------------------------------------------------------------
# 前端 reset-password 頁面 base URL；email 會拼成 `{FRONTEND_BASE_URL}/reset-password?token=...`
FRONTEND_BASE_URL=https://your-frontend-domain.com
# 寄信 transport 優先順序：SENDGRID_API_KEY > SMTP_HOST > 皆無 → log-only（dev）
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@gu-voice.local
SMTP_USE_TLS=true


# -----------------------------------------------------------------------------
# Proxy / Client IP
# -----------------------------------------------------------------------------
# 部署在 Railway / Cloudflare 等可信代理後方時才設 true，否則客戶端可偽造 X-Forwarded-For
TRUST_PROXY_HEADERS=false


# -----------------------------------------------------------------------------
# Auth Cookies / CSRF（M-22）
# -----------------------------------------------------------------------------
REFRESH_COOKIE_NAME=gu_refresh_token
CSRF_COOKIE_NAME=gu_csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
# production 必為 true；本機 http 開發可關。COOKIE_SAMESITE=none 必須搭配 Secure=true
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth


# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# 允許的前端來源，逗號分隔字串或 JSON 陣列皆可
# Gotcha：pydantic-settings v2 對 list[str] 會在 source 層先 json.loads()；
#   config.py 已對 CORS_ORIGINS（與 MULTILANG_DISABLED_LANGUAGES）加 NoDecode，
#   兩種寫法皆可。若部署的是舊 code（無 NoDecode），逗號分隔會 SettingsError → 容器啟動即 crash，
#   此時必須寫 JSON 陣列：CORS_ORIGINS=["https://a.com","https://b.com"]
CORS_ORIGINS=https://your-frontend-domain.com,https://your-admin-domain.com
