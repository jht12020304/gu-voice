# Environment files (secrets)
.env
.env.local
.env.*.local
backend/.env
# Timestamped .env backups (含 live DB 密碼 / Supabase keys，禁止入庫)
.env*.bak*

# Logs
*.log
backend/backend.log

# Node
node_modules/
frontend/node_modules/

# Vite build output
frontend/dist/

# OS
.DS_Store
Thumbs.db

# PNG design screenshots (not needed in repo)
*.png
# Exception: app logo in frontend public
!frontend/public/logo.png
# Checked-in iOS asset catalogs supply AppIcon and other bundled assets.
# Keep screenshots elsewhere ignored to protect clinical data.
!ios_native/App/Assets.xcassets/**/*.png

# Apple 簽章金鑰與憑證——一旦 commit 就等於外洩，且 git 歷史清不乾淨。
# 目前這些檔案放在 repo 外的 ../firebase-secrets/，這幾行是防手滑複製進來。
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
AuthKey_*

# Misc design/integration notes
agent-skills-main/
awesome-design-md-main/
cal/
intercom/
notion/
sentry/
stripe/
supabase/
vercel/
# Vercel 環境匯出檔（含 secrets，禁止入庫）
vercel_*.yml

# Python test cache
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp

# graphify 知識圖譜產物（用 graphify CLI 重建即可，不入庫）
graphify-out/

# Local tool caches / scratch（.claude/skills 是專案技能，要入庫；其餘 .claude 內容不入庫）
.claude/*
!.claude/skills/
.playwright-cli/
.playwright-mcp/
output/

# tsc -b 由 tsconfig.node.json（emitDeclarationOnly）產出，不入庫
frontend/vite.config.d.ts

/artifacts/
/compare.md
/declutter-plan.md
